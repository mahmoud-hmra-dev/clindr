# ============================================================
# ROOT ENVIRONMENT — used by docker-compose.yml
# IMPORTANT: Change ALL passwords before deploying to production
# NEVER commit this file to version control
# ============================================================

# --- Backend Database ---
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password_1
DB_DATABASE=clindoctor
DB_USERNAME=clindoctor
DB_PASSWORD=CHANGE_ME_strong_backend_password

# --- Payment Database ---
PAYMENT_DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password_2
PAYMENT_DB_DATABASE=clindoctor_payment
PAYMENT_DB_USERNAME=clindoctor
PAYMENT_DB_PASSWORD=CHANGE_ME_strong_payment_password

# --- Call Database ---
CALL_DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password_3
CALL_DB_NAME=clindoctor_call
CALL_DB_USER=clindoctor
CALL_DB_PASSWORD=CHANGE_ME_strong_call_password
CALL_DB_HOST=mysql_call
CALL_DB_PORT=3306

# --- Call Service (MiroTalk) ---
# REQUIRED: Generate with: openssl rand -hex 32
API_KEY_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Payment Allowed Redirect Domains (comma-separated) ---
PAYMENT_ALLOWED_REDIRECT_DOMAINS=clindoctor.net,hdf.usj.edu.lb
